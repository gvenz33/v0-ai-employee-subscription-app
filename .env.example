# Copy to .env.local for Next.js. For Vercel, set these in Project → Settings → Environment Variables.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ROOT_DOMAIN=247aiemployees.net

# --- Cron (required for /api/cron/* routes; Vercel sends Authorization: Bearer ...) ---
CRON_SECRET=

# --- Custom domains on Vercel (Founders tier; register hostnames via API) ---
# Create a token at https://vercel.com/account/tokens — scope: full account or team that owns the project.
VERCEL_TOKEN=
# Project Settings → General → Project ID (prj_...)
VERCEL_PROJECT_ID=
# Team / org ID (team_...) when the project lives under a team; optional for personal accounts.
VERCEL_TEAM_ID=
# Optional overrides for CNAME hint text in the dashboard.
# CUSTOM_DOMAIN_CNAME_TARGET=cname.vercel-dns.com
# VERCEL_PROJECT_DOMAIN_TARGET=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe Coupon ID (e.g. abc123) for 50% off — auto-applied for beta checkouts. If unset, Checkout shows a promotion code field; create Promotion Code "BETA" in Stripe Dashboard linked to that coupon.
# STRIPE_BETA_COUPON_ID=

# --- Email / automations ---
RESEND_API_KEY=
AUTOMATION_EMAIL_SECRET=
AUTOMATION_EMAIL_FROM=

# Confirmation and password-reset emails use first-party links:
#   https://your-domain.com/auth/confirm?token_hash=...&type=email
# No Supabase redirect allowlist is required for those Resend emails.
#
# Optional OAuth/PKCE redirect override (must point to /auth/callback):
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# If you still use Supabase-hosted auth emails, add redirect URLs:
#   https://your-domain.com/auth/callback
#   https://your-domain.com/auth/confirm
#   https://your-domain.com/auth/callback?next=/auth/reset-password
